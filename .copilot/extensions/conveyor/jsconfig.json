{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "module": "nodenext",
    "target": "es2023",
    "moduleResolution": "nodenext",
    "noImplicitAny": false,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["es2023"]
  },
  "typeAcquisition": {
    "enable": true,
    "include": ["node"]
  },
  "include": ["*.mjs", "fixtures/*.mjs", "types/*.d.ts"]
}
