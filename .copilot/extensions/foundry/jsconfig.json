{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "es2023",
    "types": ["node"]
  },
  "typeAcquisition": {
    "enable": true,
    "include": ["node"]
  },
  "include": [
    "**/*.mjs",
    "**/*.js",
    "**/*.ts"
  ]
}
