{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "noEmit": true,
    "paths": {
      "@github/copilot-sdk": ["/Applications/GitHub Copilot.app/Contents/Resources/copilot-sdk/index.d.ts"],
      "@github/copilot-sdk/extension": ["/Applications/GitHub Copilot.app/Contents/Resources/copilot-sdk/extension.d.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "es2023",
    "typeRoots": ["../../editor/node_modules/@types"],
    "types": ["node"]
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": [
    "**/*.mjs",
    "**/*.js",
    "**/*.ts"
  ]
}
