{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noImplicitAny": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["node"],
    "useUnknownInCatchVariables": false
  },
  "typeAcquisition": {
    "enable": true,
    "include": ["node"]
  },
  "include": [
    "conveyor/*.mjs",
    "conveyor/fixtures/*.mjs",
    "conveyor/types/*.d.ts",
    "mobius/*.mjs",
    "mobius/renderer/*.js"
  ]
}
