#!/usr/bin/env python3
"""cwf — run dynamic workflows on top of the GitHub Copilot CLI.

Usage:
    cwf run <harness.py> [options]

A harness is a plain synchronous Python script. cwf executes it with two names
injected:
    wf    -> the orchestration Runtime (wf.agent, wf.fan_out, wf.budget, ...)
    args  -> parsed --args value (any JSON), or None

Convention: the harness prints its final answer to STDOUT; cwf prints run stats
and per-agent progress to STDERR. That keeps stdout clean for scripting and for
the calling Copilot session to read back.

Stdlib only; targets Python 3.9+.
"""
from __future__ import annotations

import argparse
import ast
import datetime
import json
import os
import random
import shutil
import signal
import string
import sys
import time
from contextlib import suppress


def _bootstrap_path() -> None:
    """Make `copilot_workflows` importable whether run from the repo or $HOME.

    cwf lives at <root>/.local/bin/cwf, so the package sits at <root>/.local/lib.
    Works in-place in the dotfiles repo and after `. sync` deploys to ~/.local.
    """
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        os.path.join(os.path.dirname(here), "lib"),   # <root>/.local/lib
        os.path.expanduser("~/.local/lib"),
    ]
    for c in candidates:
        if os.path.isdir(os.path.join(c, "copilot_workflows")):
            if c not in sys.path:
                sys.path.insert(0, c)
            return


_bootstrap_path()

EFFORT_CHOICES = ("none", "low", "medium", "high", "xhigh", "max")
CONTEXT_CHOICES = ("default", "long_context")
PRESET_CHOICES = ("xtreme",)

try:
    from copilot_workflows import (
        CheckpointStore,
        ProgressReporter,
        Runtime,
        SandboxError,
        default_runs_dir,
        harness_globals,
        lint_imports,
        replay,
    )
    from copilot_workflows.runtime import BudgetExceeded
except Exception as exc:  # pragma: no cover
    sys.stderr.write(f"cwf: cannot import copilot_workflows ({exc})\n")
    sys.exit(2)


def _new_run_id(harness_path: str) -> str:
    stem = os.path.splitext(os.path.basename(harness_path))[0]
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    rnd = "".join(random.choices(string.ascii_lowercase + string.digits, k=4))
    return f"{stem}-{ts}-{rnd}"


def _parse_args_value(raw: str | None):
    if raw is None:
        return None
    if raw.startswith("@"):
        with open(os.path.expanduser(raw.removeprefix("@")), "r", encoding="utf-8") as fh:
            return json.load(fh)
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw  # treat as a plain string


def _extract_meta(source: str, path: str) -> dict:
    """Best-effort top-level ``META = {...}`` extraction. Never affects execution."""
    try:
        tree = ast.parse(source, filename=path)
    except SyntaxError:
        return {}
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        if not any(isinstance(t, ast.Name) and t.id == "META" for t in node.targets):
            continue
        try:
            raw = ast.literal_eval(node.value)
        except Exception:
            return {}
        if not isinstance(raw, dict):
            return {}
        meta = {}
        for key in ("name", "description"):
            if isinstance(raw.get(key), str) and raw[key].strip():
                meta[key] = raw[key].strip()
        phases = raw.get("phases")
        if isinstance(phases, (list, tuple)):
            vals = [p.strip() for p in phases if isinstance(p, str) and p.strip()]
            if vals:
                meta["phases"] = vals
        return meta
    return {}


def _is_skipped(r) -> bool:
    """A budget-drained agent (graceful, non-strict mode): not an error."""
    return (not r.ok) and str(getattr(r, "error", "") or "").startswith("skipped:")


def _tuning_note(rt: "Runtime") -> str:
    """One-line summary of the session-default effort/context agents inherit, if set."""
    parts = [f"{label}={value}" for label, value in
             (("effort", rt.effort), ("context", rt.context)) if value]
    return ", ".join(parts)


def _system_exit_status(exc: SystemExit) -> int:
    """Normalize a harness-raised SystemExit to a process status."""
    code = exc.code
    if code is None:
        return 0
    if isinstance(code, bool):
        return int(code)
    if isinstance(code, int):
        return code
    sys.stderr.write(f"{code}\n")
    return 1


def _prepare_run_dir(run_dir: str, run_id: str, harness_path: str, args_value,
                     resume: bool, restricted: bool, meta: dict):
    """Create the run dir, snapshot the harness, write meta, open the checkpoint store."""
    os.makedirs(run_dir, exist_ok=True)
    # keep a readable copy of the harness with the run (Claude parity)
    with suppress(Exception):
        shutil.copyfile(harness_path, os.path.join(run_dir, "harness.py"))
    _write_meta(run_dir, run_id, harness_path, args_value, resume, restricted, meta)
    return CheckpointStore(run_dir, resume=resume)


def _make_reporter(run_dir, run_id, harness_path, resume, quiet):
    """Build the progress reporter (+ a devnull sink under --quiet, returned for closing)."""
    progress_path = os.path.join(run_dir, "progress.jsonl") if run_dir else None
    if progress_path and not resume and os.path.isfile(progress_path):
        open(progress_path, "w").close()  # fresh run reusing a dir: drop stale progress
    devnull = open(os.devnull, "w") if quiet else None
    reporter = ProgressReporter(
        jsonl_path=progress_path, title=run_id or os.path.basename(harness_path),
        stream=devnull, live=False if quiet else None)
    return reporter, devnull


def _build_runtime(a: argparse.Namespace, run_dir, store, reporter, logger) -> "Runtime":
    return Runtime(
        concurrency=a.concurrency, copilot_bin=a.copilot_bin, model=a.model, effort=a.effort,
        context=a.context, default_enable_mcp=a.enable_mcp, budget=a.budget, preset=a.preset,
        strict_budget=a.strict_budget, logger=logger, progress=reporter, dry_run=a.dry_run,
        run_dir=run_dir, checkpoints=store, restricted=a.restricted, memory_path=a.memory)


def _log_run_header(logger, a: argparse.Namespace, harness_path, rt, run_id, store,
                    resume, meta: dict) -> None:
    budget = rt.budget_total
    budget_str = f"{budget:.2f}" if budget is not None else "none"
    flags = "".join((", dry-run" if a.dry_run else "", ", resume" if resume else "",
                     ", restricted" if a.restricted else "",
                     f", preset={a.preset}" if a.preset else "",
                     ", MCP on" if a.enable_mcp else ", MCP off"))
    logger(f"— cwf run {os.path.basename(harness_path)} (concurrency={rt.concurrency}, "
           f"model={rt.model or 'default'}, budget={budget_str}{flags})")
    tuning = _tuning_note(rt)
    if tuning:
        logger(f"  tuning: {tuning}")
    if meta:
        title = meta.get("name") or os.path.basename(harness_path)
        desc = f" — {meta['description']}" if meta.get("description") else ""
        logger(f"  workflow: {title}{desc}")
        if meta.get("phases"):
            logger("  phases: " + ", ".join(meta["phases"]))
    if run_id:
        cached = store.count if store else 0
        logger(f"  run id: {run_id}" + (f"  ({cached} cached)" if cached else ""))
        logger(f"  resume: cwf run {harness_path} --resume {run_id}")
    if a.memory:
        logger(f"  memory: {os.path.abspath(os.path.expanduser(a.memory))}"
               + (" (read-only: dry-run)" if a.dry_run else ""))
    if a.restricted and sys.flags.hash_randomization:
        logger("  ! restricted: hash randomization is ON — run with PYTHONHASHSEED=0 "
               "for fully reproducible set/dict ordering")


def _run_summary(rt: "Runtime", elapsed: float) -> dict:
    cached = sum(1 for r in rt.results if r.cached)
    skipped = sum(1 for r in rt.results if _is_skipped(r))
    failed = sum(1 for r in rt.results if not r.ok and not _is_skipped(r))
    launched = sum(1 for r in rt.results if not r.cached and not _is_skipped(r))
    launched_nano_aiu = sum(r.nano_aiu for r in rt.results
                            if not r.cached and not _is_skipped(r))
    total_nano_aiu = sum(r.nano_aiu for r in rt.results)
    return {"agents": len(rt.results), "launched": launched, "cached": cached,
            "skipped": skipped, "failed": failed,
            "nano_aiu": total_nano_aiu,
            "launched_nano_aiu": launched_nano_aiu,
            "elapsed": elapsed}


def _run_end_event(summary: dict, run_id: str | None) -> dict:
    rec = {"ev": "run_end", "run_id": run_id, "t": time.time()}
    rec.update(summary)
    return rec


def _finalize(logger, summary: dict, status: int) -> int:
    logger(f"— cwf: {summary['agents']} agents ({summary['cached']} cached, "
           f"{summary['skipped']} skipped, {summary['failed']} failed), "
           f"{summary['nano_aiu'] / 1_000_000_000:.1f} AIC, {summary['elapsed']:.1f}s")
    return 4 if status == 0 and summary["failed"] else status


def cmd_run(a: argparse.Namespace) -> int:
    harness_path = os.path.abspath(os.path.expanduser(a.harness))
    if not os.path.isfile(harness_path):
        sys.stderr.write(f"cwf: harness not found: {a.harness}\n")
        return 2
    try:
        with open(harness_path, "r", encoding="utf-8") as fh:
            src = fh.read()
    except OSError as e:
        sys.stderr.write(f"cwf: cannot read harness {a.harness}: {e}\n")
        return 2
    meta = _extract_meta(src, harness_path)

    args_value = _parse_args_value(a.args)
    resume = bool(a.resume)
    runs_dir = a.runs_dir or default_runs_dir()

    def logger(*parts):
        if not a.quiet:
            sys.stderr.write(" ".join(str(p) for p in parts) + "\n")
            sys.stderr.flush()

    # ---- run directory + checkpoint store (skipped for dry runs) ----
    run_id = run_dir = store = None
    if not a.dry_run:
        run_id = a.resume or a.run_id or _new_run_id(harness_path)
        run_dir = os.path.join(runs_dir, run_id)
        if resume and not os.path.isdir(run_dir):
            sys.stderr.write(f"cwf: no such run to resume: {run_id}\n")
            return 2
        store = _prepare_run_dir(
            run_dir, run_id, harness_path, args_value, resume, a.restricted, meta)

    reporter, devnull = _make_reporter(run_dir, run_id, harness_path, resume, a.quiet)
    rt = _build_runtime(a, run_dir, store, reporter, logger)
    _log_run_header(logger, a, harness_path, rt, run_id, store, resume, meta)

    reporter({"ev": "run_start", "run_id": run_id, "harness": harness_path,
              "meta": meta, "t": time.time()})
    g = harness_globals(rt, args_value, harness_path, restricted=a.restricted)

    start = time.time()
    status = 0
    try:
        if a.restricted:
            lint_imports(src, harness_path)  # fail fast before any agent spends AIC
        exec(compile(src, harness_path, "exec"), g)
    except SandboxError as e:
        sys.stderr.write(f"\ncwf: blocked by restricted mode: {e}\n")
        status = 2
    except BudgetExceeded as e:
        logger(f"\n! {e} — stopping")
        status = 3
    except SystemExit as e:
        status = _system_exit_status(e)
    except KeyboardInterrupt:
        logger(f"\n! interrupted (resume with: cwf run {a.harness} --resume {run_id or '?'})")
        status = 130
    except Exception:
        import traceback
        sys.stderr.write("\ncwf: harness raised:\n")
        traceback.print_exc()
        status = 1
    finally:
        rt.cleanup()
        elapsed = time.time() - start
        summary = _run_summary(rt, elapsed)
        with suppress(Exception):
            reporter(_run_end_event(summary, run_id))
        reporter.close()
        if devnull is not None:
            devnull.close()

    return _finalize(logger, summary, status)


def _write_meta(run_dir, run_id, harness_path, args_value, resume, restricted=False,
                workflow_meta=None):
    meta_path = os.path.join(run_dir, "meta.json")
    meta = {}
    if resume and os.path.isfile(meta_path):
        try:
            with open(meta_path, encoding="utf-8") as fh:
                meta = json.load(fh)
        except Exception:
            meta = {}
    now = datetime.datetime.now().isoformat(timespec="seconds")
    meta.setdefault("run_id", run_id)
    meta.setdefault("harness", harness_path)
    meta.setdefault("created_at", now)
    meta.setdefault("restricted", restricted)
    if workflow_meta:
        meta["workflow"] = workflow_meta
    meta["args"] = args_value
    meta["updated_at"] = now
    try:
        with open(meta_path, "w", encoding="utf-8") as fh:
            json.dump(meta, fh, indent=2)
    except Exception:
        pass


def _mtime_iso(path):
    try:
        return datetime.datetime.fromtimestamp(os.path.getmtime(path)).isoformat(timespec="seconds")
    except Exception:
        return ""


def cmd_runs(a: argparse.Namespace) -> int:
    runs_dir = a.runs_dir or default_runs_dir()
    if not os.path.isdir(runs_dir):
        print(f"no runs in {runs_dir}")
        return 0
    rows = []
    for name in os.listdir(runs_dir):
        d = os.path.join(runs_dir, name)
        if not os.path.isdir(d):
            continue
        meta = {}
        mp = os.path.join(d, "meta.json")
        if os.path.isfile(mp):
            try:
                with open(mp, encoding="utf-8") as fh:
                    meta = json.load(fh)
            except Exception:
                pass
        n, aic = 0, 0.0
        pp = os.path.join(d, "progress.jsonl")
        run_end = None
        if os.path.isfile(pp):
            try:
                with open(pp, encoding="utf-8") as fh:
                    for line in fh:
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            rec = json.loads(line)
                        except Exception:
                            continue
                        if rec.get("ev") == "run_end":
                            run_end = rec
            except Exception:
                pass
        if run_end is not None:
            n = int(run_end.get("launched") or 0)
            aic = float(run_end.get("launched_nano_aiu") or 0) / 1_000_000_000
        updated = meta.get("updated_at") or _mtime_iso(d)
        rows.append((updated, name, os.path.basename(meta.get("harness", "")), n, aic))
    if not rows:
        print(f"no runs in {runs_dir}")
        return 0
    rows.sort(reverse=True)
    print(f"{'RUN ID':<32} {'HARNESS':<20} {'AGENTS':>6} {'AIC':>8}  UPDATED")
    for updated, name, harness, n, cr in rows:
        print(f"{name[:32]:<32} {harness[:20]:<20} {n:>6} {cr:>8.1f}  {updated}")
    return 0


def cmd_watch(a: argparse.Namespace) -> int:
    runs_dir = a.runs_dir or default_runs_dir()
    path = os.path.join(runs_dir, a.run_id, "progress.jsonl")
    if not os.path.isfile(path):
        sys.stderr.write(f"cwf: no progress file for run: {a.run_id}\n")
        return 2
    replay(path, follow=not a.no_follow)
    return 0


def _parse_duration(s: str) -> float:
    s = str(s).strip().lower()
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    if s and s[-1] in units:
        return float(s[:-1]) * units[s[-1]]
    return float(s)  # bare seconds


def cmd_loop(a: argparse.Namespace) -> int:
    try:
        interval = _parse_duration(a.every)
    except Exception:
        sys.stderr.write(f"cwf: invalid --every value: {a.every}\n")
        return 2
    n = 0
    last = 0
    try:
        while True:
            n += 1
            total_str = f"/{a.max_runs}" if a.max_runs else ""
            sys.stderr.write(f"\n— cwf loop: run {n}{total_str} —\n")
            ra = argparse.Namespace(**vars(a))
            ra.resume = None         # each tick is a fresh run, not a resume
            ra.run_id = None
            last = cmd_run(ra)
            if last in (130, 143):  # SIGINT / SIGTERM during the run — stop, don't restart
                break
            if a.max_runs and n >= a.max_runs:
                break
            time.sleep(interval)
    except KeyboardInterrupt:
        sys.stderr.write(f"\n— cwf loop: stopped after {n} run(s) —\n")
    return last


def _add_run_args(pr: argparse.ArgumentParser) -> None:
    pr.add_argument("harness", help="Path to the harness Python file.")
    pr.add_argument("--args", help="JSON (or @file.json) passed to the harness as `args`.")
    pr.add_argument("--model", help="Session default model that agents inherit unless they pin "
                    "their own; the harness's per-agent choice wins. Any Copilot model "
                    "(Claude/GPT/Gemini/BYOK) or 'auto'. Mirrors Claude Code.")
    pr.add_argument("--effort", choices=EFFORT_CHOICES,
                    help="Session default reasoning effort agents inherit unless they pin their "
                         "own (the harness's per-agent choice wins). Only affects "
                         "reasoning-capable models; Copilot enforces applicability.")
    pr.add_argument("--context", choices=CONTEXT_CHOICES,
                    help="Session default context-window tier agents inherit unless they pin "
                         "their own (Copilot-specific; no Claude equivalent).")
    pr.add_argument("--preset", choices=PRESET_CHOICES,
                    help="Named run preset. 'xtreme' sets provider-neutral high-effort defaults "
                         "(model=auto, effort=xhigh, context=long_context) and a 1,000,000 AIC budget "
                         "when no explicit value is supplied.")
    pr.add_argument("--budget", type=float,
                    help="Soft observed AIC cap; in-flight agents may overshoot.")
    pr.add_argument("--strict-budget", action="store_true",
                    help="Raise/stop after the cap is hit instead of gracefully skipping new agents.")
    pr.add_argument("--concurrency", type=int, help="Max concurrent subagents.")
    pr.add_argument("--run-id", help="Explicit run id (default: auto-generated).")
    pr.add_argument("--memory", metavar="PATH",
                    help="Durable text file the harness reads/appends via wf.memory. Unlike "
                         "per-run checkpoints it persists ACROSS `cwf loop` ticks (relative to "
                         "cwd). Works in --restricted (the runtime owns the file I/O).")
    pr.add_argument("--runs-dir", help="Where run state lives "
                    "(default: $CWF_RUNS_DIR or <$CWF_WORKFLOWS_DIR|~/.copilot/workflows>/runs).")
    pr.add_argument("--enable-mcp", action="store_true",
                    help="Default agents to keep built-in MCP servers enabled.")
    pr.add_argument("--copilot-bin", default=os.environ.get("CWF_COPILOT_BIN", "copilot"),
                    help="Path to the copilot binary (default: copilot).")
    pr.add_argument("--dry-run", action="store_true", help="Plan only; don't spawn agents.")
    pr.add_argument("--quiet", action="store_true", help="Suppress cwf stderr diagnostics.")
    pr.add_argument("--restricted", action="store_true",
                    help="Run the harness orchestration-only + deterministic: no fs/proc/net "
                         "imports, no open/exec/eval, no time/random/datetime/uuid. "
                         "Defense-in-depth + resume-safety, NOT a security jail — pair with an "
                         "OS/agent sandbox (copilot --cloud / /sandbox) for untrusted authors.")


def _unwind_on_sigterm() -> None:
    """Make SIGTERM unwind like Ctrl-C so a terminated run reaps its subagents.

    Reaping lives in normal control flow (wf._concurrent_map's interrupt handler and
    run_agent's finally), which only runs if the signal raises *through* Python rather than
    killing the process outright. SIGINT already does that (KeyboardInterrupt); we just make
    SIGTERM raise SystemExit(143) too. The handler stays trivial — no locks — so it's
    signal-safe.
    """
    def _raise_exit(_signum, _frame):
        raise SystemExit(143)

    try:
        signal.signal(signal.SIGTERM, _raise_exit)
    except (ValueError, OSError):  # off the main thread / unsupported platform
        pass


def main(argv=None) -> int:
    _unwind_on_sigterm()
    p = argparse.ArgumentParser(prog="cwf", description="Dynamic workflows on the Copilot CLI.")
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="Execute a workflow harness (.py).")
    _add_run_args(r)
    r.add_argument("--resume", metavar="RUN_ID", help="Resume a run; cached agents are skipped.")
    r.set_defaults(func=cmd_run)

    lp = sub.add_parser("loop", help="Re-run a workflow on an interval (e.g. recurring triage).")
    _add_run_args(lp)
    lp.add_argument("--every", required=True, help="Interval between runs: 30s, 5m, 2h, 1d.")
    lp.add_argument("--max-runs", type=int, help="Stop after this many runs (default: unlimited).")
    lp.set_defaults(func=cmd_loop)

    ls = sub.add_parser("runs", help="List recent workflow runs.")
    ls.add_argument("--runs-dir", help="Runs directory (default: ~/.copilot/workflows/runs).")
    ls.set_defaults(func=cmd_runs)

    w = sub.add_parser("watch", help="Watch a run's live progress (tails progress.jsonl).")
    w.add_argument("run_id", help="Run id to watch.")
    w.add_argument("--runs-dir", help="Runs directory (default: ~/.copilot/workflows/runs).")
    w.add_argument("--no-follow", action="store_true", help="Render current state once and exit.")
    w.set_defaults(func=cmd_watch)

    a = p.parse_args(argv)
    return a.func(a)


if __name__ == "__main__":
    raise SystemExit(main())
