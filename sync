#!/usr/bin/env bash
# Source this file — it reloads your shell:  source ./sync
# The ./ matters: a bare `. sync` would source /bin/sync instead.

# Resolve this script's directory whether sourced from bash or zsh.
if [ -n "${ZSH_VERSION:-}" ]; then
	cd "$(dirname "${(%):-%x}")" || return
else
	cd "$(dirname "${BASH_SOURCE[0]}")" || return
fi

git pull

push() {
	rsync --exclude ".git/" --exclude ".DS_Store" --exclude "sync" --exclude "README.md" -av . ~ || return

	# Stale copies of files renamed/removed in the repo. The rsync above is
	# additive, so delete their leftovers from $HOME (after the new versions
	# have been copied in).
	local obsolete=(
		.MacOSX
		.launchd.conf
		Library/KeyBindings/DefaultKeyBinding.dict
		.bash_completion
		.bash_completion.d
		.bash_exports
		.bash_functions
		.bash_aliases
		.bash_prompt
		.copilot/agents/classifier.md
		.copilot/agents/judge.md
		.copilot/agents/synthesizer.md
		.copilot/extensions/cwf
		.copilot/extensions/mobius/factories.mjs
		.copilot/extensions/mobius/factory-helpers.mjs
		.copilot/extensions/mobius/canvas-server.mjs
		.copilot/extensions/mobius/conveyor-adapter.mjs
		.copilot/extensions/mobius/conveyor-scripts.mjs
		.copilot/extensions/mobius/conveyors/mobius-plan.mjs
		.copilot/extensions/mobius/conveyors/mobius-verify.mjs
		.copilot/extensions/mobius/test
		.copilot/extensions/mobius/test/factory-helpers.test.mjs
		.copilot/conveyors/mobius-plan.mjs
		.copilot/conveyors/mobius-verify.mjs
		.copilot/extensions/workflow
		.copilot/skills/workflow
		.copilot/workflows
		.local/bin/cwf
		.local/lib/copilot_workflows
	)
	local f
	for f in "${obsolete[@]}"; do [ -n "$f" ] && rm -rf ~/"$f"; done
}

pull() {
	find . -type f \( ! -path "*.git/*" ! -name ".DS_Store" ! -name "README.md" ! -name "sync" \) -exec cp ~/{} {} \;
}

case "$1" in
	-p | --pull) pull ;;
	-f | --force) push ;;
	*)
		printf 'This may overwrite existing files in your home directory. Are you sure? (y/n) '
		read -r REPLY
		[[ $REPLY =~ ^[Yy]$ ]] && push
		;;
esac

unset -f push pull

# Reload the current shell's config (zsh or bash), not the other's.
if [ -n "${ZSH_VERSION:-}" ]; then
	source ~/.zprofile
else
	source ~/.bash_profile
fi
