#!/usr/bin/env bash
# Source this file — it reloads your shell:  source ./sync
# The ./ matters: a bare `. sync` would source /bin/sync instead.

# Resolve this script's directory whether sourced from bash or zsh.
if [ -n "${ZSH_VERSION:-}" ]; then
	cd "$(dirname "${(%):-%x}")" || return
else
	cd "$(dirname "${BASH_SOURCE[0]}")" || return
fi

git pull

push() {
	rsync --exclude ".git/" --exclude ".DS_Store" --exclude "sync" --exclude "README.md" -av . ~

	# Stale copies of files renamed/removed in the repo. The rsync above is
	# additive, so delete their leftovers from $HOME (after the new versions
	# have been copied in).
	local obsolete=(
		.MacOSX
		.launchd.conf
		Library/KeyBindings/DefaultKeyBinding.dict
		.bash_completion
		.bash_completion.d
		.bash_exports
		.bash_functions
		.bash_aliases
		.bash_prompt
		# Python cwf engine — uncomment once no Python .cwf.py harnesses are still running in ~:
		# .local/bin/cwf
		# .local/lib/copilot_workflows
	)
	local f
	for f in "${obsolete[@]}"; do [ -n "$f" ] && rm -rf ~/"$f"; done

	# The deployed Python `.cwf.py` harnesses need a glob (they sit next to the kept `.cwf.mjs`), and
	# it can't be an obsolete[] entry: this file is SOURCED, so it also runs under zsh, and zsh —
	# unlike bash — does NOT glob-expand a variable's contents, only a glob written literally here.
	# Uncomment together with the two `.local` entries above, once no Python harnesses remain:
	# rm -f ~/.copilot/workflows/*.cwf.py ~/.copilot/skills/workflow/examples/*.cwf.py
}

pull() {
	find . -type f \( ! -path "*.git/*" ! -name ".DS_Store" ! -name "README.md" ! -name "sync" \) -exec cp ~/{} {} \;
}

case "$1" in
	-p | --pull) pull ;;
	-f | --force) push ;;
	*)
		printf 'This may overwrite existing files in your home directory. Are you sure? (y/n) '
		read -r REPLY
		[[ $REPLY =~ ^[Yy]$ ]] && push
		;;
esac

unset -f push pull

# Reload the current shell's config (zsh or bash), not the other's.
if [ -n "${ZSH_VERSION:-}" ]; then
	source ~/.zprofile
else
	source ~/.bash_profile
fi
