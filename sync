#!/usr/bin/env bash
# Source this file — it reloads your shell:  source ./sync
# The ./ matters: a bare `. sync` would source /bin/sync instead.

# Resolve this script's directory whether sourced from bash or zsh.
if [ -n "${ZSH_VERSION:-}" ]; then
	cd "$(dirname "${(%):-%x}")" || return
else
	cd "$(dirname "${BASH_SOURCE[0]}")" || return
fi

git pull

push() {
	rsync --exclude ".git" --exclude ".DS_Store" --exclude "sync" --exclude "/sync.test.mjs" --exclude "/README.md" --exclude "/AGENTS.md" \
		--exclude "/.copilot/editor/node_modules/" --exclude "/.copilot/extensions/foundry" --exclude "/.copilot/skills/foundry" -av . ~ || return
	local item
	for item in extensions/recon skills/{deep-research,review-queue,security-review}; do
		rsync --exclude ".git" --delete --checksum -av ".copilot/$item/" "$HOME/.copilot/$item/" || return
	done

	# Stale copies of files renamed/removed in the repo. The rsync above is
	# additive, so delete their leftovers from $HOME (after the new versions
	# have been copied in).
	local obsolete=(
		.bash_completion
		.bash_completion.d
		.bash_exports
		.bash_functions
		.bash_aliases
		.bash_prompt
	)
	local f
	for f in "${obsolete[@]}"; do [ -n "$f" ] && rm -rf ~/"$f"; done
	printf '%s\n' 'Foundry extension and skill left unchanged; install them together in an offline maintenance window.'
}

pull() {
	find . \( -name ".git" -o -path "./.copilot/editor/node_modules" -o -path "./.copilot/extensions/foundry" -o -path "./.copilot/skills/foundry" \) -prune \
		-o -type f ! -name ".DS_Store" ! -path "./README.md" ! -path "./AGENTS.md" ! -name "sync" ! -path "./sync.test.mjs" -exec cp ~/{} {} \;
}

case "$1" in
	-p | --pull) pull ;;
	-f | --force) push ;;
	*)
		printf 'This may overwrite existing files in your home directory. Are you sure? (y/n) '
		read -r REPLY
		[[ $REPLY =~ ^[Yy]$ ]] && push
		;;
esac

unset -f push pull

# Reload the current shell's config (zsh or bash), not the other's.
if [ -n "${ZSH_VERSION:-}" ]; then
	source ~/.zprofile
else
	source ~/.bash_profile
fi
