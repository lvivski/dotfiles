#!/usr/bin/env bash
# Source this file — it reloads your shell:  source ./sync
# The ./ matters: a bare `. sync` would source /bin/sync instead.

# Resolve this script's directory whether sourced from bash or zsh.
if [ -n "${ZSH_VERSION:-}" ]; then
	cd "$(dirname "${(%):-%x}")" || return
else
	cd "$(dirname "${BASH_SOURCE[0]}")" || return
fi

git pull

push() {
	rsync --exclude ".git/" --exclude ".DS_Store" --exclude "sync" --exclude "/README.md" -av . ~ || return
	# Extension and skill directories are mirrors, not additive overlays.
	rsync --delete -av .copilot/extensions/foundry/ ~/.copilot/extensions/foundry/ || return
	rsync --delete -av .copilot/skills/foundry/ ~/.copilot/skills/foundry/ || return
	rsync --delete -av .copilot/skills/deep-research/ ~/.copilot/skills/deep-research/ || return
	rsync --delete -av .copilot/skills/review-queue/ ~/.copilot/skills/review-queue/ || return
	rsync --delete -av .copilot/skills/security-review/ ~/.copilot/skills/security-review/ || return

	# Stale copies of files renamed/removed in the repo. The rsync above is
	# additive, so delete their leftovers from $HOME (after the new versions
	# have been copied in).
	local obsolete=(
		.MacOSX
		.launchd.conf
		.gitattributes
		Library/KeyBindings/DefaultKeyBinding.dict
		.bash_completion
		.bash_completion.d
		.bash_exports
		.bash_functions
		.bash_aliases
		.bash_prompt
		.copilot/agents/classifier.md
		.copilot/agents/judge.md
		.copilot/agents/synthesizer.md
		.copilot/extensions/cwf
		.copilot/extensions/conveyor
		.copilot/extensions/jsconfig.json
		.copilot/extensions/mobius
		.copilot/extensions/types
		.copilot/conveyors
		.copilot/extensions/workflow
		.copilot/skills/conveyor
		.copilot/skills/mobius
		.copilot/skills/workflow
		.local/bin/cwf
		.local/lib/copilot_workflows
	)
	local f
	for f in "${obsolete[@]}"; do [ -n "$f" ] && rm -rf ~/"$f"; done
}

pull() {
	find . -type f \( ! -path "*.git/*" ! -name ".DS_Store" ! -path "./README.md" ! -name "sync" \) -exec cp ~/{} {} \;
}

case "$1" in
	-p | --pull) pull ;;
	-f | --force) push ;;
	*)
		printf 'This may overwrite existing files in your home directory. Are you sure? (y/n) '
		read -r REPLY
		[[ $REPLY =~ ^[Yy]$ ]] && push
		;;
esac

unset -f push pull

# Reload the current shell's config (zsh or bash), not the other's.
if [ -n "${ZSH_VERSION:-}" ]; then
	source ~/.zprofile
else
	source ~/.bash_profile
fi
